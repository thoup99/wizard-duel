# Copy to .env. Use lowercase for the GHCR image path.
POCKET_MAGES_IMAGE=ghcr.io/thoup99/wizard-duel:latest
PORT=8000
# 127.0.0.1 if your reverse proxy runs directly on the host; otherwise configure a reachable interface.
BIND_ADDRESS=0.0.0.0
DEV_MODE=false
# Optional: a long random token for protected gesture recording and threshold reload.
ADMIN_TOKEN=
# Empty means same-origin WebSockets. With a proxy, preserve Host or set the exact HTTPS origin.
ALLOWED_ORIGINS=
MAX_ROOMS=100
